# Copy to .env and fill in. See docs/architecture.md for the safety invariants.

# --- Surfaces / auth ---
# Mandatory outside dev: an unset key with AUTH_DISABLED unset refuses to boot.
TRADER_API_KEY=
TRADER_AUTH_DISABLED=true
# Where the CLI finds the running API.
TRADER_API_BASE_URL=http://localhost:8080

# --- Store ---
TRADER_DATABASE_URL=postgresql://trader:trader@localhost:5544/trader

# --- Safety gates (default: paper only, live impossible) ---
TRADER_ALPACA_LIVE_ENABLED=false

# --- LLM endpoints ---
TRADER_NEMOTRON_BASE_URL=http://localhost:8009/v1

# --- Broker / data (Alpaca paper) ---
# Same keys serve broker and market data. Rate-limit budget (Basic/free tier):
# ~200 req/min across data endpoints; crypto data free; equities = IEX feed only.
# Our fetch-on-tick load is ~2 req/wakeup/symbol — far below budget.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET=

# --- Market data fallbacks ---
# Twelve Data free tier: 8 credits/min, 800/day (1 credit per quote/time_series call).
# Fallback only — untouched unless Alpaca equities data fails.
# TWELVE_DATA_API_KEY=
# FRED free key (https://fred.stlouisfed.org/docs/api/api_key.html); responses TTL-cached
# 1h in-process, so live load is a few calls/day.
# FRED_API_KEY=

# --- Grok / xAI (research roles) ---
# XAI_API_KEY=            # fallback if SuperGrok OAuth is unavailable
