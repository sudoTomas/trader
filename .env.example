# Copy to .env and fill in. See docs/architecture.md for the safety invariants.

# --- Surfaces / auth ---
# Mandatory outside dev: an unset key with AUTH_DISABLED unset refuses to boot.
TRADER_API_KEY=
TRADER_AUTH_DISABLED=true
# Where the CLI finds the running API.
TRADER_API_BASE_URL=http://localhost:8080

# --- Store ---
TRADER_DATABASE_URL=postgresql://trader:trader@localhost:5544/trader

# --- Safety gates (default: paper only, live impossible) ---
TRADER_ALPACA_LIVE_ENABLED=false

# --- LLM endpoints ---
TRADER_NEMOTRON_BASE_URL=http://localhost:8009/v1

# --- Broker / data (Alpaca paper) ---
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET=

# --- Grok / xAI (research roles) ---
# XAI_API_KEY=            # fallback if SuperGrok OAuth is unavailable
