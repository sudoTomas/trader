# Copy to .env and fill in. Generated by scripts/gen_config_reference.py from
# trader.ops.config.Settings; the full reference is docs/configuration.md.
# Commented lines show the default; uncomment to override. Never commit .env.

# --- Surfaces / auth ---
# [credential] Bearer key the API and MCP surfaces require. Mandatory outside dev: an unset key
# with `TRADER_AUTH_DISABLED` unset refuses to boot.
TRADER_API_KEY=
# [credential] Capture-scoped second key for external research agents (Hermes). It may only
# submit, list and retire research notes and read the Macro View: on REST those four routes
# (plus `/health`), on MCP the `/mcp-capture/` mount alone. Every other route and `/mcp/` answer
# 403. Blank means no capture key exists; it never substitutes for `TRADER_API_KEY`.
# TRADER_CAPTURE_API_KEY=
# [gate] Explicit dev opt-out from API auth. Without it, an unset `TRADER_API_KEY` fails boot
# (fail closed). Never set on a reachable box.
TRADER_AUTH_DISABLED=true
# [endpoint] Where the CLI finds the running API.
TRADER_API_BASE_URL=http://localhost:8080

# --- Store ---
# [endpoint] Postgres DSN for the journal, ledger, research store and audit log. The test suite
# appends `_test` to it and truncates that sibling database.
TRADER_DATABASE_URL=postgresql://trader:trader@localhost:5544/trader

# --- Safety gates ---
# [gate] Live Alpaca client construction refuses unless this is `true`. Paper only by default;
# there is no other path to a live venue.
TRADER_ALPACA_LIVE_ENABLED=false

# --- Decide loop ---
# [gate] Shadow mode defaults ON: the pipeline runs and journals every decision, and submits
# nothing. Set `false` to let RiskGuard-approved intents reach the paper broker.
# TRADER_SHADOW_MODE=true
# [gate] Runs the background decide loop inside the API process. An explicit operator opt-in;
# off, the surfaces still serve but nothing ticks.
# TRADER_LOOP_ENABLED=false
# [tuning] Seconds between scheduler ticks (quote fetch, mark, trigger evaluation).
# TRADER_LOOP_TICK_SECONDS=60.0
# [tuning] Cap on heartbeat wakeups per tick (0 = no cap). Set it when the watchlist is large:
# heartbeats beyond the cap wait for the next tick, most overdue first, so startup, each cadence
# and each market open do not burst the data API's rate limit. Price-move, vol-spike and
# sentiment triggers are never capped.
# TRADER_LOOP_MAX_HEARTBEATS_PER_TICK=0
# [tuning] Comma-separated symbols the loop watches and may trade.
# TRADER_LOOP_SYMBOLS=BTC/USD,ETH/USD
# [gate] Per-symbol shadow: comma-separated tickers that decide and risk-check but never submit,
# while the rest of the build trades live-paper. A new symbol earns its flip here first.
# TRADER_SHADOW_SYMBOLS=SPY
# [gate] Exit-review lane: with a position held, the decide prompt gains a held-position block
# (entry, age, unrealized P&L, latest sentiment) and an explicit ask to justify holding versus
# `close`/reduce. Advisory only, RiskGuard never sees it. A decide-behavior change: flip only
# through `docs/runbooks/decide-change-gate.md` (replay it with `trader eval run --exit-review
# --seed-qty --seed-entry`).
# TRADER_EXIT_REVIEW_ENABLED=false
# [tuning] Equity the risk chain assumes in shadow builds (no broker). Live-paper builds read
# equity from the broker and keep the last good value when it is down.
# TRADER_SHADOW_EQUITY=100000.0

# --- Risk limits (RiskGuard) ---
# [tuning] Max notional of one position as a fraction of equity.
# TRADER_RISK_MAX_POSITION_FRAC=0.1
# [tuning] Opens below this notional are denied (no dust orders), clamps included.
# TRADER_RISK_MIN_NOTIONAL_USD=5.0
# [tuning] Max open positions; a new open beyond it is denied, adds and exits pass.
# TRADER_RISK_MAX_CONCURRENT_POSITIONS=5
# [tuning] Max submitted trades per UTC day, counted across symbols.
# TRADER_RISK_MAX_TRADES_PER_DAY=20
# [tuning] Daily loss breaker: equity down this fraction from the session start halts opens
# until an operator resumes it.
# TRADER_RISK_DAILY_LOSS_LIMIT_FRAC=0.03
# [tuning] Weekly drawdown breaker, same mechanics as the daily limit.
# TRADER_RISK_WEEKLY_DRAWDOWN_LIMIT_FRAC=0.1
# [tuning] Unattended opens above this notional clamp down to it and execute; the clamp is
# journaled. Exits are never clamped.
# TRADER_RISK_APPROVAL_NOTIONAL_USD=1000.0
# [tuning] `0` disables parking. A value above the approval cap parks larger opens for a human
# (`trader risk approve`); everything between the cap and this band clamps to the cap and
# executes unattended.
# TRADER_RISK_PARK_ABOVE_USD=0.0

# --- Research Desk ---
# [tuning] Days before an unpinned note auto-stales out of compilation (retire stays explicit).
# TRADER_RESEARCH_STALE_DAYS=30
# [tuning] Quiet window after the last note change before the Macro View recompiles.
# TRADER_RESEARCH_COMPILE_DEBOUNCE_SECONDS=30.0
# [tuning] One-way markdown mirror folder (gitignored, regenerable). Empty disables.
# TRADER_RESEARCH_MIRROR_DIR=research
# [gate] Per-candidate briefs: briefs compile and store on note changes regardless; this flag
# alone lets them into the decide prompt. A decide-behavior change: flip only through
# `docs/runbooks/decide-change-gate.md`.
# TRADER_BRIEFS_ENABLED=false
# [gate] Decision desk: analyst fan-out + cross-model critic around the decide. Dark by default;
# earns its flip via replay desk-on vs desk-off, then a shadow window.
# TRADER_DESK_ENABLED=false
# [tuning] Critic spend cap per UTC day (the critic prefers Grok, cross-model). At the cap,
# reviews degrade to journaled pass-throughs. Analysts run on the decide client.
# TRADER_DESK_CRITIC_DAILY_USD=1.0
# [tuning] X sentiment poll interval for held symbols; needs an xAI credential (x_search runs
# server-side on xAI). The daily call cap still bounds a shorter interval.
# TRADER_SENTIMENT_POLL_SECONDS=10800.0
# [tuning] Max sentiment polls per UTC day across symbols.
# TRADER_SENTIMENT_DAILY_CALL_CAP=24
# [gate] Lets a sentiment swing wake the decide loop. Shadow-first: leave OFF until at least a
# week of journaled scores looks sane. Code default off; a live book arms it in `.env`, never
# here.
# TRADER_SENTIMENT_TRIGGER_ENABLED=false
# [tuning] Score move between polls that wakes the trader; scores are on [-1, 1].
# TRADER_SENTIMENT_SWING_THRESHOLD=0.5
# [tuning] Comma-separated allowlist of X handles for x_search; empty = open search.
# TRADER_SENTIMENT_X_HANDLES=
# [tuning] Screener liquidity floor: symbols whose 20-day average dollar volume (close x volume)
# is below this are skipped before ranking. The screener is a query (`GET /screener`,
# `get_screener`, `trader screener run`); it is not wired into the decide loop.
# TRADER_SCREENER_MIN_DOLLAR_VOLUME_USD=50000000.0
# [tuning] Daily bars the screener fetches per symbol (one or two multi-symbol Alpaca requests
# per query, nothing stored). Must cover the 60-day momentum window: at least 61 trading days;
# 90 leaves slack for holidays.
# TRADER_SCREENER_LOOKBACK_DAYS=90
# [endpoint] Grok model for the desk seats (`trader seat run <seat>`, a standalone process
# outside `trader-api`). Must be entitled on `/v1/responses` with `x_search` and `web_search`
# (probe matrix: docs/research/xai-api.md). The seat authenticates with the shared SuperGrok
# OAuth login by default (cross-process refresh lock, #68); `--credential api_key` pins
# `XAI_API_KEY` instead.
# TRADER_SEAT_MODEL=grok-4.3
# [tuning] Hard cap on notes one seat sweep may submit after the grounding and dedupe gates; the
# rest are dropped and logged.
# TRADER_SEAT_MAX_NOTES=3
# [tuning] Seat note body cap. A longer body is sent back to the model to distill once; still
# over → dropped. Keeps notes inside the decide prompt's research lane.
# TRADER_SEAT_NOTE_MAX_CHARS=1400
# [tuning] Append-only JSONL of seat runs (submitted note ids, usage, estimated cost). The seat
# runs outside the service meter, so this is its spend record; `trader seat report` reads it
# back for the citation loop.
# TRADER_SEAT_STATE_PATH=~/.local/state/trader/seat-runs.jsonl

# --- LLM endpoints ---
# [endpoint] Nemotron preset: a self-hosted vLLM `/v1` (default :8009, no auth). Used for decide
# and analysts when `TRADER_DECIDE_BASE_URL` is empty; the preset client sends
# `chat_template_kwargs: {enable_thinking: false}` on every request (without it the endpoint
# collapses to ~0.35 tok/s). A generic URL equal to this one gets the same flag forced on.
# Inside compose, point it at `http://host.docker.internal:8009/v1`.
TRADER_NEMOTRON_BASE_URL=http://localhost:8009/v1
# [endpoint] Served model id on the Nemotron vLLM. Swapping the decide model on an existing box
# is a decide-behavior change (`docs/runbooks/decide-change-gate.md`); for a new user it is
# simply the first run.
# TRADER_NEMOTRON_MODEL=nemotron-3-super
# [endpoint] Any OpenAI-compatible `/v1` for the decide (and analyst) role: OpenAI, Groq,
# Together, Ollama, vLLM, xAI. Empty selects the Nemotron preset above, which is the only client
# that sends `chat_template_kwargs`; a vendor API such as OpenAI rejects that argument, so it is
# never sent to a generic URL.
# TRADER_DECIDE_BASE_URL=
# [endpoint] Model id at `TRADER_DECIDE_BASE_URL` (ignored under the Nemotron preset).
# TRADER_DECIDE_MODEL=
# [credential] Bearer key for `TRADER_DECIDE_BASE_URL`; blank for unauthenticated hosts.
# TRADER_DECIDE_API_KEY=
# [tuning] JSON object merged into every chat-completions body for the decide client (e.g.
# `{"reasoning_effort": "low"}`). Must parse as an object. Ollama / llama.cpp ignore
# `chat_template_kwargs`; their no-thinking switch is `{"reasoning_effort": "none"}`. Without it
# a reasoning model burns the decide token budget thinking and returns empty content.
# TRADER_DECIDE_EXTRA_BODY=
# [tuning] USD per 1M input tokens for the decide model. `0` reads the built-in PRICES table,
# else $0 (logged once); non-zero overrides the table.
# TRADER_DECIDE_PRICE_IN=0.0
# [tuning] USD per 1M output tokens for the decide model; same rules as the input price.
# TRADER_DECIDE_PRICE_OUT=0.0
# [endpoint] Empty: no Confirm. `jev`: TypeSafe's Jev judgment model is asked about every open
# or close Draft (`TRADER_CONFIRM_*`) and its answer is journaled in the decision's `confirm`
# column. Journal-only: it never changes an order.
# TRADER_CONFIRM_PROVIDER=
# [endpoint] Jev's judgment endpoint for the confirm role.
# TRADER_CONFIRM_BASE_URL=https://api.typesafe.ai/v1/systemone
# [endpoint] Jev model id for the confirm role.
# TRADER_CONFIRM_MODEL=jev-latest
# [credential] TypeSafe API key for the confirm role; required when
# `TRADER_CONFIRM_PROVIDER=jev`. Errors report the HTTP status only.
# TRADER_CONFIRM_API_KEY=
# [endpoint] Same shape as the decide endpoint, for the brief, compiler, critic and registry
# sentiment roles. Empty keeps xAI if configured, else the decide client. x_search stays
# xAI-only.
# TRADER_RESEARCH_BASE_URL=
# [endpoint] Model id at `TRADER_RESEARCH_BASE_URL`.
# TRADER_RESEARCH_MODEL=
# [credential] Bearer key for `TRADER_RESEARCH_BASE_URL`.
# TRADER_RESEARCH_API_KEY=
# [tuning] JSON object merged into the research roles' chat-completions bodies. On Ollama /
# llama.cpp use `{"reasoning_effort": "none"}` to turn thinking off (`chat_template_kwargs` is
# ignored there); otherwise a reasoning model spends the token budget thinking and returns empty
# content.
# TRADER_RESEARCH_EXTRA_BODY=
# [tuning] USD per 1M input tokens for the research model (`0` = PRICES table, else $0).
# TRADER_RESEARCH_PRICE_IN=0.0
# [tuning] USD per 1M output tokens for the research model.
# TRADER_RESEARCH_PRICE_OUT=0.0
# [endpoint] xAI API base for Grok research roles and x_search sentiment.
# TRADER_XAI_BASE_URL=https://api.x.ai/v1
# [endpoint] Grok model id for the xAI research roles.
# TRADER_XAI_MODEL=grok-4
# [credential] xAI API key: first-class fallback when SuperGrok OAuth is absent or quarantined.
# Provider-conventional name; the `TRADER_` form is accepted too.
# Also accepted: TRADER_XAI_API_KEY
# XAI_API_KEY=
# [credential] SuperGrok device-code OAuth: Fernet key that encrypts the token store. Set it,
# then run `trader xai login`. Generate with `python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"`. Unset, OAuth is disabled and the provider resolves to
# `XAI_API_KEY` alone.
# TRADER_XAI_TOKEN_KEY=
# [tuning] Encrypted SuperGrok OAuth token store path.
# TRADER_XAI_TOKEN_PATH=~/.config/trader/xai_token.enc

# --- Broker / market data credentials ---
# [credential] Alpaca paper key id. The same keys serve broker and market data. Rate-limit
# budget (Basic/free tier): ~200 req/min across data endpoints; crypto data free; equities = IEX
# feed only. Fetch-on-tick load is ~2 req/wakeup/symbol, far below budget.
# Also accepted: TRADER_ALPACA_API_KEY_ID
# ALPACA_API_KEY_ID=
# [credential] Alpaca paper secret, paired with `ALPACA_API_KEY_ID`.
# Also accepted: TRADER_ALPACA_API_SECRET
# ALPACA_API_SECRET=
# [credential] Twelve Data key, equities-quote fallback only (untouched unless Alpaca equities
# data fails). Free tier: 8 credits/min, 800/day, 1 credit per quote or time_series call.
# Also accepted: TRADER_TWELVE_DATA_API_KEY
# TWELVE_DATA_API_KEY=
# [credential] FRED key (https://fred.stlouisfed.org/docs/api/api_key.html) for the macro
# context line; responses are TTL-cached 1h in-process, so live load is a few calls/day. Absent,
# the decide prompt carries no FRED line.
# Also accepted: TRADER_FRED_API_KEY
# FRED_API_KEY=
