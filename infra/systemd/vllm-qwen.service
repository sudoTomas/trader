# Qwen3.6-35B-A3B NVFP4 on vLLM, as a systemd *user* unit, on :8012 — the fast general-purpose
# local model (Mem0 extraction, the trader's local fallback, ad-hoc long-context work). GB10-specific: see
# docs/research/2026-11-spark-model-allocation.md (Plan B). The recipe is the model card's
# DGX Spark one with the memory share cut from 0.4 to 0.25, the context from 256K to 128K and the default weight loader (fastsafetensors staged the checkpoint in host RAM and OOMed the box on 2026-11-11).
# The share, not --max-model-len, sizes the KV pool: at 0.25 it holds ~209K tokens, so 128K costs
# no extra memory (1.6 concurrent 128K requests; more when they are short). Start it after
# vllm-qwen27 is up: vLLM checks free memory at start.
#
# Install:
#   cp infra/systemd/vllm-qwen.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now vllm-qwen
# LAN only and unauthenticated, the same trust model as :8009.
[Unit]
Description=Qwen3.6-35B-A3B NVFP4 on vLLM (:8012, general purpose, 128K)
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=-/usr/bin/docker rm -f vllm-qwen
ExecStart=/usr/bin/docker run --rm --name vllm-qwen --gpus all \
  -v %h/.cache/huggingface:/root/.cache/huggingface \
  -p 8012:8000 \
  vllm/vllm-openai:v0.27.1 \
    --model nvidia/Qwen3.6-35B-A3B-NVFP4 \
    --served-model-name qwen3.6-35b-a3b \
    --host 0.0.0.0 --port 8000 \
    --trust-remote-code \
    --kv-cache-dtype fp8 \
    --attention-backend flashinfer \
    --moe-backend marlin \
    --gpu-memory-utilization 0.25 \
    --max-model-len 131072 \
    --max-num-seqs 4 \
    --max-num-batched-tokens 8192 \
    --enable-chunked-prefill \
    --async-scheduling \
    --enable-prefix-caching \
    --speculative-config '{"method":"mtp","num_speculative_tokens":3,"moe_backend":"triton"}' \
    --default-chat-template-kwargs '{"enable_thinking": false}' \
    --reasoning-parser qwen3 \
    --tool-call-parser qwen3_xml \
    --enable-auto-tool-choice
ExecStop=/usr/bin/docker stop -t 30 vllm-qwen
# vLLM can exit 0 on EngineDeadError, so restart on every exit.
Restart=always
RestartSec=30
TimeoutStartSec=1200

[Install]
WantedBy=default.target
